extern void object::ReturnBot6() //a script for the builder, goes to coordinates relayed by the grabber and constructs power facilities
{
	object ship = radar(SpaceShip);
	point placedCube;
	
	goto(ship.position);
	
	while (testinfo("placedCubeX",20) == false)
	{
		wait(1);
	}
	message("Builder - Loading information from Exchange Post.");
	
	placedCube.x = receive("placedCubeX",20);
	placedCube.y = receive("placedCubeY",20);
	placedCube.z = receive("placedCubeZ",20);
	
	message("Builder - Removing original information for the grabber.");
	deleteinfo("placedCubeX",20);
	deleteinfo("placedCubeY",20);
	deleteinfo("placedCubeZ",20);
	message("Builder - Going to the placed cube to construct PowerStation.");
	goto(placedCube);
	build(PowerStation);
	Maintenance(0.5);
	message("Builder - Returning to spaceship to wait for further instructions.");
	goto(ship.position);
	//second PowerCaptor
	while (testinfo("placedCubeX",20) == false)
	{
		wait(1);
	}
	message("Builder - Second PowerCaptor - Loading information from Exchange Post.");
	
	placedCube.x = receive("placedCubeX",20);
	placedCube.y = receive("placedCubeY",20);
	placedCube.z = receive("placedCubeZ",20);
	
	message("Builder - Removing original information for the grabber.");
	deleteinfo("placedCubeX",20);
	deleteinfo("placedCubeY",20);
	deleteinfo("placedCubeZ",20);
	message("Builder - Going to the placed cube to construct PowerPlant.");
	goto(placedCube);
	build(PowerPlant);
	Maintenance(0.5);
}
void object::Maintenance(float triggerValue)
{
	int list[], i;
	object power,repair;
	
	i = 0;
	list[i++] = PowerStation;
	list[i++] = PowerCaptor;
	errmode(0);
	power = radar(list);
	
	if(energyCell.energyLevel < triggerValue && energyCell.category != NuclearCell)
	{
		message("Battery low, going to recharge facility", DisplayInfo);
		goto(power.position);
		while(energyCell.energyLevel < 1)
		{
			wait(1);
		}
	}
	else if (energyCell.energyLevel < triggerValue and power == null and energyCell.category == PowerCell) //checking if we have power cell so that we wont display this error needlessly
	{
		message("Power Station/Captor not found.", DisplayError);
	}
	else if (energyCell.energyLevel < triggerValue and canbuild(PowerStation) == false && canbuild(PowerCaptor) == false) //can't do canbuild(list), it expects a int value (not list) or category name
	{
		message("Power Station/Captor not accessible in this mission.", DisplayWarning);
	}
	
	repair = radar(RepairCenter);
	
	if(shieldLevel < triggerValue)
	{
		message("Structural integrity low, going to Repair Center", DisplayInfo);
		goto(repair.position);
		while(shieldLevel < 1)
		{
			wait(1);
		}
	}
	else if (shieldLevel < triggerValue and repair == null)
	{
		message("Repair Center not found.", DisplayError);
	}
	else if (shieldLevel < triggerValue and canbuild(repair.category) == false)
	{
		message("Repair Center not accessible in this mission.", DisplayWarning);
	}
	
	errmode(1);
}