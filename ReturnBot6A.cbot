extern void object::ReturnBot6() //a script for the builder, goes to coordinates relayed by the grabber and constructs power facilities
{
	object ship = radar(SpaceShip);
	goto(ship.position);
	
	while (testinfo("placedCubeX",20) == false)
	{
		wait(1);
	}
	message("Builder - Loading information from Exchange Post.");
		
		placedCube.x = receive("placedCubeX",20);
		placedCube.y = receive("placedCubeY",20);
		placedCube.z = receive("placedCubeZ",20);
		
		message("Builder - Removing original information for the grabber.");
		deleteinfo("placedCubeX",20);
		deleteinfo("placedCubeY",20);
		deleteinfo("placedCubeZ",20);
		message("Builder - Going to the placed cube to construct PowerStation.");
		goto(placedCube);
		build(PowerCaptor);
		Maintenance(0.2);
		message("Builder - Returning to spaceship to wait for further instructions.");
		goto(ship.position);
		//second PowerCaptor
		while (testinfo("placedCubeX",20) == false)
		{
			wait(1);
		}
		message("Builder - Second PowerCaptor - Loading information from Exchange Post.");
		
		placedCube.x = receive("placedCubeX",20);
		placedCube.y = receive("placedCubeY",20);
		placedCube.z = receive("placedCubeZ",20);
		
		message("Builder - Removing original information for the grabber.");
		deleteinfo("placedCubeX",20);
		deleteinfo("placedCubeY",20);
		deleteinfo("placedCubeZ",20);
		message("Builder - Going to the placed cube to construct PowerPlant.");
		goto(placedCube);
		build(PowerCaptor);
		Maintenance(0.2);
}