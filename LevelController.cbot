	object[] otherBuildings = radarall(list4);
	
	for(int j = 0;j < sizeof(otherBuildings);j++)
	{
		int cat = otherBuildings[j].category;
		point pos = otherBuildings[j].position;
		float orientation = otherBuildings[j].orientation;
		float energy = otherBuildings[j].energyLevel;
		float shieldL = otherBuildings[j].shieldLevel;
		
		handle4.writeln("Category: " + (cat+0)+"");
		handle4.writeln("PositionX: " + pos.x);
		handle4.writeln("PositionY: " + pos.y);
		handle4.writeln("PositionZ: " + pos.z);
		handle4.writeln("Orientation: " + orientation);
		handle4.writeln("Energy: " + energy);
		handle4.writeln("ObjectName: " + cat);
		handle4.writeln("SEPARATOR");
	}
	handle4.close();
	
