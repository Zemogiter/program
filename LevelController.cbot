float object::FigureOutCell(string ccString, string clString) //since produce() does not know what to do with object.cell, we need to extract useful information from it
{
	int cellCategory;
	
	if (strfind(ccString, "PowerCell") != nan)
	{
		cellCategory = PowerCell;
	}
	else if (strfind(ccString, "NuclearCell") != nan)
	{
		cellCategory = NuclearCell;
	}
	else
	{
		cellCategory = -1;
	}
	
	string cellLevelString = strmid(clString,11,strlen(clString));
	float cellLevel = strval(cellLevelString);
	
	if(cellCategory == PowerCell)
	{
		float usedEnergy = 1-cellLevel;
		float returnValue = 1-usedEnergy;
		return returnValue;
	}
	else if(cellCategory == NuclearCell)
	{
		float usedEnergy = 100-cellLevel;
		float returnValue = 100-usedEnergy;
		return returnValue;
	}
	else
	{
		return -1; //remember to change it once produce() power cell parameter works as intended
	}
	return nan;
}
void object::ObjectSaver()
{
	// handling grabbers
	file handle();
	handle.open("GrabberList.txt", "w");
	
	int[] list;
	int i = 0;
	
	list[i++] = WheeledGrabber;
	list[i++] = TrackedGrabber;
	list[i++] = WingedGrabber;
	list[i++] = LeggedGrabber;
	
	object[] grabberList = radarall(list);
	
	for(int j = 0;j < sizeof(grabberList);j++)
	{
		int cat = grabberList[j].category;
		point pos = grabberList[j].position;
		float orientation = grabberList[j].orientation;
		object cell = grabberList[j].energyCell;
		
		if (load != null)
		{
			handle.writeln("Category: " + (cat+0)+"");
			handle.writeln("PositionX: " + pos.x);
			handle.writeln("PositionY: " + pos.y);
			handle.writeln("PositionZ: " + pos.z);
			handle.writeln("Orientation: " + orientation);
			handle.writeln("CellCategory: " + cell.category);
			handle.writeln("CellLevel: " + cell.energyLevel);
			handle.writeln("ObjectName: " + cat);
			handle.writeln("SEPARATOR");
		}
		else
		{
			handle.writeln("Category: " + (cat+0)+"");
			handle.writeln("PositionX: " + pos.x);
			handle.writeln("PositionY: " + pos.y);
			handle.writeln("PositionZ: " + pos.z);
			handle.writeln("Orientation: " + orientation);
			handle.writeln("CellCategory: " + cell.category);
			handle.writeln("CellLevel: " + cell.energyLevel);
			handle.writeln("ObjectName: " + cat);
			handle.writeln("SEPARATOR");
		}
	}
	handle.close();
	
	// handling other bots
	file handle2();
	handle2.open("BotList.txt", "w");
	
	int[] list2;
	i = 0;
	
	list2[i++] = PracticeBot;
	list2[i++] = WheeledSniffer;
	list2[i++] = TrackedSniffer;
	list2[i++] = WingedSniffer;
	list2[i++] = LeggedSniffer;
	list2[i++] = WheeledShooter;
	list2[i++] = TrackedShooter;
	list2[i++] = WingedShooter;
	list2[i++] = LeggedShooter;
	list2[i++] = WheeledOrgaShooter;
	list2[i++] = TrackedOrgaShooter;
	list2[i++] = WingedOrgaShooter;
	list2[i++] = LeggedOrgaShooter;
	list2[i++] = Recycler;
	list2[i++] = Thumper;
	list2[i++] = Shielder;
	list2[i++] = PhazerShooter;
	list2[i++] = WheeledBuilder;
	list2[i++] = TrackedBuilder;
	list2[i++] = WingedBuilder;
	list2[i++] = LeggedBuilder;
	
	object[] botList = radarall(list2);
	
	for(int j = 0;j < sizeof(botList);j++)
	{
		int cat = botList[j].category;
		point pos = botList[j].position;
		float orientation = botList[j].orientation;
		object cell = botList[j].energyCell;
		
		handle2.writeln("Category: " + (cat+0)+"");
		handle2.writeln("PositionX: " + pos.x);
		handle2.writeln("PositionY: " + pos.y);
		handle2.writeln("PositionZ: " + pos.z);
		handle2.writeln("Orientation: " + orientation);
		handle2.writeln("CellCategory: " + cell.category);
		handle2.writeln("CellLevel: " + cell.energyLevel);
		handle2.writeln("ObjectName: " + cat);
		handle2.writeln("SEPARATOR");
	}
	handle2.close();
	
	// handling buildings with cell slots
	file handle3();
	handle3.open("CellBuildings.txt", "w");
	
	int[] list3;
	i = 0;
	
	list3[i++] = ResearchCenter;
	list3[i++] = DefenseTower;
	list3[i++] = PowerPlant;
	list3[i++] = NuclearPlant;
	
	object[] cellBuildings = radarall(list3);
	
	for(int j = 0;j < sizeof(cellBuildings);j++)
	{
		int cat = cellBuildings[j].category;
		point pos = cellBuildings[j].position;
		float orientation = cellBuildings[j].orientation;
		float energy = cellBuildings[j].energyLevel;
		object cell = cellBuildings[j].energyCell;
		
		if (cell != null)
		{
			cell = cellBuildings[j].energyCell;
			handle3.writeln("Category: " + (cat+0)+"");
			handle3.writeln("PositionX: " + pos.x);
			handle3.writeln("PositionY: " + pos.y);
			handle3.writeln("PositionZ: " + pos.z);
			handle3.writeln("Orientation: " + orientation);
			handle3.writeln("Energy: " + energy);
			handle3.writeln("CellCategory: " + cell.category);
			handle3.writeln("CellLevel: " + cell.energyLevel);
			handle3.writeln("ObjectName: " + cat);
			handle3.writeln("SEPARATOR");
		}
		else
		{
			handle3.writeln("Category: " + (cat+0)+"");
			handle3.writeln("PositionX: " + pos.x);
			handle3.writeln("PositionY: " + pos.y);
			handle3.writeln("PositionZ: " + pos.z);
			handle3.writeln("Orientation: " + orientation);
			handle3.writeln("Energy: " + energy);
			handle3.writeln("ObjectName: " + cat);
			handle3.writeln("SEPARATOR");
		}
		
	}
	handle3.close();
	
	//handling other buildings
	file handle4();
	handle4.open("OtherBuildings.txt", "w");
	
