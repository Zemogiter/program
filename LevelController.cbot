/*
Notes from the dev(s):

Regarding the endmission() command when there is a SpaceShip on the map. From hexagonrecursion, colobot discord:
If there is a space ship and the spaceship is selectable and there is no EndMissionTake ... immediat=1, endmission(01)  enables the spaceship to takeoff instead of ending the mission.
Your options:
1. The player has to press "take off" to end the mission
2. Remove the spaceship
3. Make the space ship non-selectable CreateObject type=SpaceShip selectable=0 ...
4. Add an EndMissionTake that will never be satisfied with immediat=1. Example: EndMissionTake pos=0;0 dist=1000type=Me min=20 immediat=1

produce() does not support object.shield or object.load as a parameter for the object to be spawned, so collecting those is pointless at the moment
*/
extern void object::LevelController() // script to be executed on LevelController, reads certain txt files in user directory, spawns object accordingly, waits for the right condition, then saves the objects on map to be spawned on the next mission, then ends the current mission/allows the player to take off
{
	ipf(10000);
	while ( ismovie() != 0 ) // script should wait until the cutscenes are over
	{
		wait(1);
	}
	ObjectLoader();
	//waiting until mission objectives are complete, EndMissionTake in scene.txt should be commented out (except for the Astronaut)
	while()
	{
		message("DEBUG - mission objectives not finished yet.");
		wait(30);
	}
	//comment out this message for public release!!!
	message("DEBUG - Mission objectives finished. If this message is displayed otherwise, there is a error in LevelController script!", DisplayWarning);
	wait(1);
	ObjectSaver();
	endmission(0,1);
}
void object::ObjectLoader()
{
	// handling grabbers
	file handle();
	handle.open("GrabberList.txt", "r");
	
	while (not handle.eof()) //while we haven't reached the end of the file
	{
		bool done = false;
		string s = null;
		point pos;
		int cat;
		float orientation;
		string ccString;
		string clString;
		string debugString;
		
		while (done != true) //while we haven't reached the line that separates entities in txt files
		{
			done = false;
			string s = handle.readln();
			
			if (strleft ( s, 8 ) == "Category")
			{
				string cString = s;
				int len = strlen(cString);
				string mid = strmid(s,10,len);
				int val = strval(mid);
				cat = val;
			}
			else if (strleft ( s, 9 ) == "PositionX")
			{
				string xString = s;
				int len = strlen(xString);
				pos.x = strval(strmid(s,11,len));
			}
			else if (strleft ( s, 9 ) == "PositionY")
			{
				string yString = s;
				int len = strlen(yString);
				pos.y = strval(strmid(s,11,len));
			}
			else if (strleft ( s, 9 ) == "PositionZ")
			{
				string zString = s;
				int len = strlen(zString);
				pos.z = strval(strmid(s,11,len));
			}
			else if (strleft ( s, 11 ) == "Orientation")
			{
				string oString = s;
				int len = strlen(oString);
				orientation = strval(strmid(s,13,len));
			}
			else if (strleft ( s, 12 ) == "CellCategory")
			{
				ccString = s;
			}
			else if (strleft ( s, 9 ) == "CellLevel")
			{
				clString = s;
			}
			else if (strleft(s,10) == "ObjectName")
			{
				debugString = s;
			}
			else
			{
				done = true;
			}
		}
		if (handle.eof())
		{
			break;
		}
		message("DEBUG - Spawning " + debugString + " " + cat +" at " + pos + " at an angle of " + orientation + " with this cell parameters: " + FigureOutCell(ccString, clString));
