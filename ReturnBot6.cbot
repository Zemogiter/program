extern void object::ReturnBot6() //code for the mission 5-1 (Volcano), grabber goes to the lava shore and places cubes there for the builder to construct the PowerStation and PowerPlant
{
	object cube, placedCube, ship;
	
	ship = radar(SpaceShip);
	//first cube
	if (radar(PowerStation) == null)
	{
		cube = radar(Titanium);
		goto(cube.position);
		grab();
		goto(52.4808,151.372,2);
		
		object ore = radar(TitaniumOre,0,45,0,10);
		
		if (ore != null)
		{
			turn(90);
		}
		
		drop();
		wait(0.5);
		placedCube = radar(Titanium,0,45,0,5);
		message("Grabber - Cube for PowerStation placed, moving to spaceship to relay information.");
		goto(ship.position);
		message("Grabber - Sending placed cube coordinates for the builder.");
		send("placedCubeX", placedCube.position.x,20);
		send("placedCubeY", placedCube.position.y,20);
		send("placedCubeZ", placedCube.position.z,20);
		while (radar(PowerStation) == null)
		{
			wait(1);
		}
		Maintenance(0.5);
	}
	//second cube
	cube = radar(Titanium);
	goto(cube.position);
	grab();
	goto(51.8894,142.756,2.11222);
	//to-do: check if we need to rotate the grabber and figure out how to do it consistently
	drop();
	wait(0.5);
	placedCube = radar(Titanium,0,45,0,5);
	message("Grabber - Cube for PowerPlant placed, moving to spaceship to relay information.");
	goto(ship.position);
	message("Sending placed cube coordinates for the builder.");
	send("placedCubeX", placedCube.position.x,20);
	send("placedCubeY", placedCube.position.y,20);
	send("placedCubeZ", placedCube.position.z,20);
	Maintenance(0.5); 
}
void object::Maintenance(float triggerValue)
{
	errmode(0);
	
	int list[], cellList[];
	object power, repair, cell;
	
	list[0] = PowerStation;
	list[1] = PowerCaptor;
	
	power = radar(list);
	
	cellList[0] = PowerCell;
	cellList[1] = NuclearCell;
	
	cell = radar(cellList);
	
	//checking for batteries first, in case they're the only way to recharge a bot or they're more accessible
	if (this.category != Subber)
	{
		//no power facility on the map
		if (power == null) 
		{
			if (this.energyCell.energyLevel <= triggerValue && cell.energyLevel >= this.energyCell.energyLevel && cell.energyLevel >= triggerValue)
			{
				if (cell.category == PowerCell)
				{
					message("CollectTitanium4() - " + this.category + " " + this.id + " " + " - No recharge facility found - swapping with better PowerCell.");
				}
				else if (cell.category == NuclearCell)
				{
					message("CollectTitanium4() - " + this.category + " " + this.id + " " + " - No recharge facility found - swapping with better NuclearCell.");
				}
				trygoto(cell.position);
				if (load != null)
				{
					turn(90);
					drop();
					turn(-90);
				}
				grab();
				drop(Behind);
				grab(EnergyCell);
				drop();
				grab(Behind);
				drop(EnergyCell);
			}
		}
		//power facility exists but cell is closer
		else if (power != null && cell != null && distance(position, cell.position) < distance(position, power.position)) 
		{
			if (this.energyCell.energyLevel <= triggerValue && cell.energyLevel >= this.energyCell.energyLevel && cell.energyLevel >= triggerValue)
			{
				if (cell.category == PowerCell)
				{
					message("CollectTitanium4() - " + this.category + " " + this.id + " " + " - Can't reach power facility or a PowerCell is closer.");
				}
				else if (cell.category == NuclearCell)
				{
					message("CollectTitanium4() - " + this.category + " " + this.id + " " + " - Can't reach power facility or a NuclearCell is closer.");
				}
				trygoto(cell.position);
				if (load != null)
				{
					turn(90);
					drop();
					turn(-90);
				}
				grab();
				drop(Behind);
				grab(EnergyCell);
				drop();
				grab(Behind);
				drop(EnergyCell);
			}
		}
	}
	
	//going to recharge facility
	if(power != null && energyCell.energyLevel < triggerValue && energyCell.category != NuclearCell)
	{
		message("CollectTitanium4() - " + this.category + " " + this.id + " " + " - Battery low, going to the recharge facility");
		if(search(Any,power.position,0,2,1,FilterOnlyLanding | FilterFriendly) != null) //if there is a object (most likely another bot) on the recharge facility
		{
			trygoto(space(power.position));
		}
		trygoto(power.position);
		while(energyCell.energyLevel < 1)
		{
			wait(1);
		}
	}
	else if (energyCell.energyLevel < triggerValue && power == null && energyCell.category == PowerCell) //checking if we have power cell so that we wont display this error needlessly
	{
		message("CollectTitanium4() - " + this.category + " " + this.id + " " + " - Power Station/Captor not found.", DisplayError);
		trygoto(cell.position);
		
		if (load != null)
		{
			turn(90);
			drop();
			turn(-90);
		}
		
		grab();
		drop(Behind);
		grab(EnergyCell);
		drop();
		grab(Behind);
		drop(EnergyCell);
	}
	else if (energyCell.energyLevel < triggerValue && canbuild(PowerStation) == false && canbuild(PowerCaptor) == false && energyCell.category == PowerCell) //can't do canbuild(list), it expects a int value (not list) or category name
	{
		message("CollectTitanium4() - " + this.category + " " + this.id + " " + " - Power Station/Captor not accessible in this mission.", DisplayWarning);
		trygoto(cell.position);
		
		if (load != null)
		{
			turn(90);
			drop();
			turn(-90);
		}
		
		grab();
		drop(Behind);
		grab(EnergyCell);
		drop();
		grab(Behind);
		drop(EnergyCell);
	}
	
	//integrity check
	int repairList[];
	
	repairList[0] = RepairCenter;
	repairList[1] = Shielder;
	
	repair = radar(repairList);
	
	if(repair != null && shieldLevel < 0.5)
	{
		message("CollectRawResources() - " + this.category + " " + this.id + " " + " - Structural integrity low, going to Repair Center", DisplayInfo);
		trygoto(repair.position);
		while(shieldLevel < 1)
		{
			wait(1);
		}
	}
	else if (shieldLevel < 0.5 && repair == null)
	{
		message("CollectRawResources() - " + this.category + " " + this.id + " " + " - Power Station/Captor not found.", DisplayError);
	}
	else if (shieldLevel < 0.5 && canbuild(RepairCenter) == false && repair == null)
	{
		message("CollectRawResources() - " + this.category + " " + this.id + " " + " - Power Station/Captor not accessible in this mission.", DisplayWarning);
	}
	
	errmode(1);
}
void object::trygoto(point pos)
{
	errmode(0);
	int tries = 0;
	
	while (distance(position, pos) > 0) //While we are moving towards destination...
	{
		while (goto(pos) != 0) //How we are handling goto() errors
		{
			if(tries > 2)
			{
				point midPoint;
				midPoint.x = ((position.x + pos.x) / 2);
				midPoint.y = ((position.y + pos.y) / 2);
				midPoint.z = ((position.z + pos.z) / 2);
				goto(midPoint);
				wait(1);
				goto(pos, 0, 1);
				break;
			}
			else wait(2);
			tries++;
		}
		errmode(1);
		break;
	}
}