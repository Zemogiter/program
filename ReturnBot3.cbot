extern void object::ReturnBot3() //A program for titanium gathering in mission 2-1 of ReturnBot
{
	object item = radar(TitaniumOre);
	float triggerValue = 0.2; //grabber will go to switch it's Power Cell once it reaches this level
	
	object[] itemList = radarall(item.category); 
	object ship = radar(SpaceShip);
	
	int counter = 0;
	
	Maintenance(triggerValue);
	
	if (load != null && load.category == TitaniumOre)
	{
		message("Already carrying the ore");
		trygoto(space(ship.position, 0, 10, 7.5)); 
		turn(direction(ship.position) + 90);
		drop();
	}
	
	while (counter != 4)
	{
		while (distance(ship.position, itemList[counter].position) < 10)
		{
			counter++;
		}
		trygoto(itemList[counter].position);
		grab();
		if(load != null and load.category != TitaniumOre) //if grabber has a incorrect item
		{
			message("Grabber picked up the wrong item, correcting.");
			
			while (load.category != Titanium)
			{
				goto(space());
				drop();
				trygoto(itemList[counter].position);
				grab();
			}
		}
		trygoto(space(ship.position, 0, 10, 7.5)); 
		turn(direction(ship.position) + 90);
		drop();
	}
	
	Maintenance(triggerValue);
	
	
}
void object::trygoto(point pos)
{
	errmode(0);
	int tries = 0;
	while (distance(position, pos) > 0) //While we are moving towards destination...
	{
		while (goto(pos) != 0) //How we are handling goto() errors
		{
			if(tries > 2)
			{
				point midPoint;
				midPoint.x = ((position.x + pos.x) / 2);
				midPoint.y = ((position.y + pos.y) / 2);
				midPoint.z = ((position.z + pos.z) / 2);
				goto(midPoint);
				wait(0.5);
				goto(pos, 0, 1);
				break;
			}
			else wait(2);
			tries++;
		}
		errmode(1);
		break;
	}
}
void object::Maintenance(float triggerValue)
{
	errmode(0);
	
	int list[], cellList[];
	
	cellList[0] = PowerCell;
	cellList[1] = NuclearCell;
	
	object cell = radar(cellList);
	
	if (this.energyCell.energyLevel <= triggerValue && cell.energyLevel >= this.energyCell.energyLevel)
	{
		message("Battery low, swapping with a different one");
		trygoto(cell.position);
		if (load != null)
		{
			turn(180);
			drop();
			turn(180);
		}
		grab();
		drop(Behind);
		grab(EnergyCell);
		drop();
		grab(Behind);
		drop(EnergyCell);
	}
}