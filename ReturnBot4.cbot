extern void object::ReturnBot4() //a simple little code that moves the sniffer to the location of uranium deposit and places a marker there for the grabbers
{
	point scanPoint(98.4905,-13.0464,18.25);
	object ship = radar(SpaceShip);
	goto(scanPoint);
	turn(direction(ship.position));
	sniff();
	goto(flatspace(ship.position,2,8));
}
