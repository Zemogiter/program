extern void object::RecyclerAutomation()
{
	object[] wreckList = radarall(Wreck);
	int underwaterWrecks = underwaterWrecksCounter(wreckList);
	
	if (wreckCheck() == null)
	{
		//message("No wrecks found on the map.");
		return;
	}
	else
	{
		if (search(BotFactory,position,0,4) != null)
		{
			move(-7);
		}
		if (underwaterWrecks != -1)
		{
			message("Number of wrecks found on the map: " + sizeof(wreckList) + "(" + underwaterWrecks + " underwater)");
			if (sizeof(wreckList) == underwaterWrecks)
			{
				message("All wrecks are underwater, halting program");
				return;
			}
		}
		else if (underwaterWrecks == -1)
		{
			message("Number of wrecks found on the map: " + sizeof(wreckList));
		}
		else if (sizeof(wreckList) == underwaterWrecks)
		{
			message("All wrecks are underwater, halting program");
			return;
		}
	}
	//main loop
	while(wreckList != null) //checks for wrecks on map before anything else, otherwise the program stops after recycling a single wreck
	{
		if (energyCell != null && energyCell.energyLevel < 0.5 && energyCell.category != NuclearCell or shieldLevel < 0.5) //Check for battery/integrity before anything else
		{
			Maintenance();
		}
		
		object wreckInFront = radar(Wreck,0,50,0,5); //handling wrecks right in front separately to avoid unnecessary moving the recycler and wasting battery
		
		if(wreckInFront != null)
		{
			message("DEBUG - Wreck in front of recycler found.");
			errmode(0);
			if (recycle() != 0)
			{
				RecyclerMainFunction(wreckInFront);
			}
			errmode(1);
		}
		turn(direction(wreckCheck().position));
		RecyclerMainFunction(wreckInFront);
		wreckCheck();
	}
}
int object::underwaterWrecksCounter(object[] wreckList)
{
	int underwaterWrecksCount = 0;
	int i;
	int j = sizeof(wreckList);
	
	for (i = 0; i < j; i++)
	{
		if (topo(wreckList[i].position) < 0)
		{
			underwaterWrecksCount++;
		}
	}
	if (underwaterWrecksCount > 0)
	{
		return underwaterWrecksCount;
	}
	return -1;
}
void object::RecyclerMainFunction(object wreckInFront)
{
	errmode(0);
	if (wreckInFront != null)
	{
		RecyclerFailureHandler(wreckInFront);
	}
	trygoto(space(wreckCheck().position));
	
	point a;
	a.z=wreckCheck().position.z;
	a.x=wreckCheck().position.x-((wreckCheck().position.x-position.x)/distance2d(position,wreckCheck().position))*5;    a.y=wreckCheck().position.y-((wreckCheck().position.y-position.y)/distance2d(position,wreckCheck().position))*5;
	
	goto(a);
	
	if (recycle() == 0 and wreckCheck() != null)
	{
		message("Wreck recycled, moving on.");
	}
	else if (recycle() != 0 and wreckCheck() != null) //recycle() failed so we try to the other side of the wreck
	{
		RecyclerFailureHandler(wreckInFront);
	}
	else if (wreckCheck() == null)
	{
		return;
	}
	errmode(1);
}
void object::RecyclerFailureHandler(object wreckInFront) // handles cases when Recycler gets stuck when recycling
{
	message("Recycler failiure, repositioning.", DisplayWarning);
	float angle = wreckInFront.orientation;
	float radius = 10;
	point otherSide;
	otherSide.x = wreckInFront.position.x + radius * cos(angle);
	otherSide.y = wreckInFront.position.y + radius * sin(angle);
	otherSide.z = wreckInFront.position.z;
	
	if(topo(otherSide) > 0)
	{
		trygoto(otherSide);
		turn(direction(wreckInFront.position));
		recycle();
	}
	else if (topo(otherSide) < 0)
	{
		message("Cannot adjust position, halting program!", DisplayError);
		return;
	}
}
object object::wreckCheck()
{
	object wreck = radar(Wreck); //defining wreck object here to prevent illegal object errors
	object[] wreckList;
	
	if (wreck != null && topo(wreck.position) < 0) //wreck underwater, looking for a different one
	{
		wreckList = radarall(Wreck);
		for(int i = 0; i < sizeof(wreckList); ++i)
		{
			if (topo(wreckList[i].position) >= 0)
			{
				wreck = wreckList[i];
				break;
			}
		}
		return wreck;
	}
	else if (wreck != null && topo(wreck.position) > 0)
	{
		return wreck;
	}
	else if (wreck == null or wreckList == null)
	{
		message("No wrecks found on the map.");
		return null;
	}
	message("No safe to reach wrecks found.", DisplayWarning);
	return null;
}
void object::Maintenance()
{
	int list[], i;
	object power,repair;
	
	i = 0;
	list[i++] = PowerStation;
	list[i++] = PowerCaptor;
	
	errmode(0);
	
	power = radar(list);
	
	if(energyCell.energyLevel < 0.5 && energyCell.category != NuclearCell)
	{
		message("Battery low, going to recharge facility", DisplayInfo);
		trygoto(power.position);
		//UltimaGoto(power.position,0,false);
		while(energyCell.energyLevel < 1)
		{
			wait(1);
		}
	}
	else if (energyCell.energyLevel < 0.5 && radar(list) == null && energyCell.category == PowerCell) //checking if we have power cell so that we wont display this error needlessly
	{
		message("Power Station/Captor not found.", DisplayError);
	}
	else if (energyCell.energyLevel < 0.5 && canbuild(PowerStation) == false && canbuild(PowerCaptor) == false) //can't do canbuild(list), it expects a int value (not list) or category name
	{
		message("Power Station/Captor not accessible in this mission.", DisplayWarning);
	}
	
	repair = radar(RepairCenter);
	
	if(shieldLevel < 0.5)
	{
		message("Structural integrity low, going to Repair Center", DisplayInfo);
		trygoto(repair.position);
		//UltimaGoto(repair.position,0,false);
		while(shieldLevel < 1)
		{
			wait(1);
		}
	}
	else if (shieldLevel < 0.5 && radar(repair.category) == null)
	{
		message("Power Station/Captor not found.", DisplayError);
	}
	else if (shieldLevel < 0.5 && canbuild(repair.category) == false)
	{
		message("Power Station/Captor not accessible in this mission.", DisplayWarning);
	}
	
	errmode(1);
}
void object::trygoto(point pos)
{
	errmode(0);
	int tries = 0;
	
	while (distance(position, pos) > 0) //While we are moving towards destination...
	{
		while (goto(pos) != 0) //How we are handling goto() errors
		{
			if(tries > 2)
			{
				point midPoint;
				midPoint.x = ((position.x + pos.x) / 2);
				midPoint.y = ((position.y + pos.y) / 2);
				midPoint.z = ((position.z + pos.z) / 2);
				goto(midPoint);
				wait(1);
				goto(pos, 0, 1);
				break;
			}
			else wait(2);
			tries++;
		}
		errmode(1);
		break;
	}
}
