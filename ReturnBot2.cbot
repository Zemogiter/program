extern void object::ReturnBot2() //a quick and dirty program to prepare resources for Space Ship takeoff
{
	object item = radar(PowerCell); //change accordingly
	bool ignoreShip = false; // have a BlueFlag ready if you set this to true
	float triggerValue = 0.4; //grabber will go recharge it's Power Cell once it reaches this level
	bool loadFullCells = false;
	bool ignoreBaseBuildings = true; //if true, grabber will take resources to the SpaceShip even if they're near the base
	
	object[] itemList = radarall(item.category); 
	object ship = radar(SpaceShip);
	
	if(ship == null or ignoreShip == true)
	{
		ship = radar(BlueFlag);
	}
	
	Maintenance(triggerValue);
	if(load != null && load.category != item.category)
	{
		drop();
		TransportToShip(ship,false,itemList, item, triggerValue, ignoreShip, loadFullCells, ignoreBaseBuildings);
	}
	else if (load != null && load.category == item.category)
	{
		TransportToShip(ship,true,itemList, item, triggerValue, ignoreShip, loadFullCells, ignoreBaseBuildings);
	}
	else
	{
		TransportToShip(ship,false,itemList, item, triggerValue, ignoreShip, loadFullCells, ignoreBaseBuildings);
	}
	Maintenance(triggerValue);
}
void object::TransportToShip(object ship, bool hasItem, object[] itemList, object item, float triggerValue, bool ignoreShip, bool loadFullCells, bool ignoreBaseBuildings)
{
	for(int i = 0;i <= sizeof(itemList);i++)
	{
		if(i == sizeof(itemList))
		{
			message("Finished the transportation of " + item.category + " to " + ship.category);
			break;
		}
		if (itemList[i].category == NuclearCell && itemList[i].energyLevel < 0.01)
		{
			continue; // we should ignore (nearly)empty Nuclear Cells
		}
		
		object botFactory = radar(BotFactory);
		object converter = search(Converter,ship.position);
		int[] spotList;
		spotList[0] = PowerSpot;
		spotList[1] = TitaniumSpot;
		spotList[2] = UraniumSpot;
		spotList[3] = KeyASpot;
		spotList[4] = KeyBSpot;
		spotList[5] = KeyCSpot;
		spotList[6] = KeyDSpot;
		object spot = radar(spotList);
		
		if (distance(itemList[i].position, ship.position) > 10)
		{
			if ((botFactory != null and distance(itemList[i].position,botFactory.position) > 5) and (converter != null and distance(itemList[i].position,converter.position) > 5) or ignoreBaseBuildings == true)
			{
				if (spot != null and distance(itemList[i].position, spot.position) > 5)
				{
					continue;
				}
				if (loadFullCells == true and itemList[i].category == PowerCell and itemList[i].energyLevel < 1)
				{
					continue;
				}
				Maintenance(triggerValue);
				if (hasItem == false)
				{
					trygoto(itemList[i].position);
					grab();
				}
				if (ignoreShip == true)
				{
					goto(space(ship.position));
				}
				else
				{
					goto(flatspace(ship.position,2,2,10));
					move(-2);
				}
				drop();
			}
		}
	}
}
void object::trygoto(point pos)
{
	errmode(0);
	int tries = 0;
	while (distance(position, pos) > 0) //While we are moving towards destination...
	{
		while (goto(pos) != 0) //How we are handling goto() errors
		{
			if(tries > 2)
			{
				point midPoint;
				midPoint.x = ((position.x + pos.x) / 2);
				midPoint.y = ((position.y + pos.y) / 2);
				midPoint.z = ((position.z + pos.z) / 2);
				goto(midPoint);
				wait(0.5);
				goto(pos, 0, 1);
				break;
			}
			else wait(2);
			tries++;
		}
		errmode(1);
		break;
	}
}
void object::Maintenance(float triggerValue)
{
	errmode(0);
	
	int list[], cellList[];
	object power, repair, cell;
	
	list[0] = PowerStation;
	list[1] = PowerCaptor;
	
	power = radar(list);
	
	cellList[0] = PowerCell;
	cellList[1] = NuclearCell;
	
	cell = radar(cellList);
	
	//checking for batteries first, in case they're the only way to recharge a bot or they're more accessible
	if (this.category != Subber)
	{
		//no power facility on the map
		if (power == null) 
		{
			if (this.energyCell.energyLevel <= triggerValue && cell.energyLevel >= this.energyCell.energyLevel && cell.energyLevel >= triggerValue)
			{
				if (cell.category == PowerCell)
				{
					message("ReturnBot2() - " + this.category + " " + this.id + " " + " - No recharge facility found - swapping with better PowerCell.");
				}
				else if (cell.category == NuclearCell)
				{
					message("ReturnBot2() - " + this.category + " " + this.id + " " + " - No recharge facility found - swapping with better NuclearCell.");
				}
				trygoto(cell.position);
				if (load != null)
				{
					turn(180);
					drop();
					turn(180);
				}
				grab();
				drop(Behind);
				grab(EnergyCell);
				drop();
				grab(Behind);
				drop(EnergyCell);
			}
		}
		//power facility exists but cell is closer
		else if (power != null && cell != null && distance(position, cell.position) < distance(position, power.position)) 
		{
			if (this.energyCell.energyLevel <= triggerValue && cell.energyLevel >= this.energyCell.energyLevel && cell.energyLevel >= triggerValue)
			{
				if (cell.category == PowerCell)
				{
					message("ReturnBot2() - " + this.category + " " + this.id + " " + " - Can't reach power facility or a PowerCell is closer.");
				}
				else if (cell.category == NuclearCell)
				{
					message("ReturnBot2() - " + this.category + " " + this.id + " " + " - Can't reach power facility or a NuclearCell is closer.");
				}
				trygoto(cell.position);
				if (load != null)
				{
					turn(180);
					drop();
					turn(180);
				}
				grab();
				drop(Behind);
				grab(EnergyCell);
				drop();
				grab(Behind);
				drop(EnergyCell);
			}
		}
	}
	
	//going to recharge facility
	if(power != null && energyCell.energyLevel < triggerValue && energyCell.category != NuclearCell)
	{
		trygoto(power.position);
		while(energyCell.energyLevel < 1)
		{
			wait(1);
		}
	}
	else if (energyCell.energyLevel < triggerValue && power == null && energyCell.category == PowerCell) //checking if we have power cell so that we wont display this error needlessly
	{
		message("ReturnBot2() - " + this.category + " " + this.id + " " + " - Power Station/Captor not found.", DisplayError);
	}
	else if (energyCell.energyLevel < triggerValue && canbuild(PowerStation) == false && canbuild(PowerCaptor) == false && energyCell.category == PowerCell) //can't do canbuild(list), it expects a int value (not list) or category name
	{
		message("ReturnBot2() - " + this.category + " " + this.id + " " + " - Power Station/Captor not accessible in this mission.", DisplayWarning);
	}
	
	//integrity check
	int repairList[];
	
	repairList[0] = RepairCenter;
	repairList[1] = Shielder;
	
	repair = radar(repairList);
	
	if(repair != null && shieldLevel < 0.5)
	{
		message("ReturnBot2() - " + this.category + " " + this.id + " " + " - Structural integrity low, going to Repair Center", DisplayInfo);
		trygoto(repair.position);
		while(shieldLevel < 1)
		{
			wait(1);
		}
	}
	else if (shieldLevel < 0.5 && repair == null)
	{
		message("ReturnBot2() - " + this.category + " " + this.id + " " + " - Power Station/Captor not found.", DisplayError);
	}
	else if (shieldLevel < 0.5 && canbuild(RepairCenter) == false && repair == null)
	{
		message("ReturnBot2() - " + this.category + " " + this.id + " " + " - Power Station/Captor not accessible in this mission.", DisplayWarning);
	}
	
	errmode(1);
}