extern void object::CubesToSpots()
{
	float triggerValue = 0.4; // bot will move to recharge batteries/shields once they reach this level
	
	int[] spotList;
	spotList[0] = PowerSpot;
	spotList[1] = TitaniumSpot;
	spotList[2] = UraniumSpot;
	spotList[3] = KeyASpot;
	spotList[4] = KeyBSpot;
	spotList[5] = KeyCSpot;
	spotList[6] = KeyDSpot;
	if(canbuild(RadarStation) == true) // in user levels, this is usually used to indicate RadioStation should be there to finish the mission
	{
		spotList[7] = WayPoint;
	}
	object[] spotList2 = radarall(spotList);
	object[] cubeList = radarall(Titanium);
	
	
	if(load != null && load.category == Titanium)
	{
		message("Bot has the cube already, not searching for one.");
	}
	
	for(int i = 0; i <= sizeof(spotList2); i++)
	{
		Maintenance(triggerValue);
		object spot = SelectNextSpot(spotList2);
		
		if(spot == null)
		{
			break;
		}
		else
		{
			if(load == null)
			{
				object cube = SelectNextCube(cubeList, spot);
				
				if(cube == null)
				{
					break;
				}
				goto(cube.position);
				errmode(0);
				if(grab() != 0) //if the cube was taken away/destroyed, looks for the nearest one
				{
					 cube = radar(Titanium);
					 goto(cube.position);
					 grab();
				}
				else if(load != null && load.category != Titanium)
				{
					message("Bot has the wrong, correcting.");
					goto(space(position));
					drop();
					goto(cube.position);
					grab();
				}
				errmode(1);
			}
			goto(spot.position);
			wait(1); //need to wait after goto, otherwise move throws an error
			move(-1.5); //making sure we drop the cube exactly at the spot
			drop();
			message("Dropped titanium cube on " + spot.category + " at " + spot.position);
		}
	}
}
object object::SelectNextCube(object[] cubeList,object spot)
{
	for(int i = 0; i <= sizeof(cubeList); i++)
	{
		if(i == sizeof(cubeList) or spot == null)
		{
			message("Not enough cubes for spots or every spot already has a cube.", DisplayError);
			return null;
		}
		if(search(PowerSpot,cubeList[i].position,0,2) != null or search(TitaniumSpot,cubeList[i].position,0,2) != null or search(UraniumSpot,cubeList[i].position,0,2) != null)
		{
			continue;
		}
		else
		{
			return cubeList[i];
		}
		
	}
	return null;
}
object object::SelectNextSpot(object[] spotList)
{
	for(int i = 0; i <= sizeof(spotList); i++)
	{
		if(i == sizeof(spotList) and spotList != null)
		{
			message("All spots have cubes next to them, or not enough cubes for all the spots on map. Ensure at least " + sizeof(spotList) + " cubes are available.", DisplayWarning);
			return null;
		}
		else if(sizeof(spotList) == 0)
		{
			message("No spots found on the map.", DisplayWarning);
			return null;
		}
		if(spotList[i] != null && search(Titanium,spotList[i].position,0,2) == null) //checking for null to prevent illegal object errors
		{
			return spotList[i];
		}
	}
	return null;
}
void object::Maintenance(float triggerValue)
{
	errmode(0);
	
	int list[], cellList[];
	object power, repair, cell;
	
	list[0] = PowerStation;
	list[1] = PowerCaptor;
	
	power = radar(list);
	
	cellList[0] = PowerCell;
	cellList[1] = NuclearCell;
	
	cell = radar(cellList);
	
	//checking for batteries first, in case they're the only way to recharge a bot or they're more accessible
	if (this.category != Subber)
	{
		//no power facility on the map
		if (power == null) 
		{
			if (this.energyCell.energyLevel <= triggerValue && cell.energyLevel >= this.energyCell.energyLevel && cell.energyLevel >= triggerValue && NuclearCellCheck(cell) == true)
			{
				if (cell.category == PowerCell)
				{
					message("CollectTitanium4() - " + this.category + " " + this.id + " " + " - No recharge facility found - swapping with better PowerCell.");
				}
				else if (cell.category == NuclearCell)
				{
					message("CollectTitanium4() - " + this.category + " " + this.id + " " + " - No recharge facility found - swapping with better NuclearCell.");
				}
				trygoto(cell.position);
				if (load != null)
				{
					turn(90);
					drop();
					turn(-90);
				}
				grab();
				drop(Behind);
				grab(EnergyCell);
				drop();
				grab(Behind);
				drop(EnergyCell);
			}
		}
		//power facility exists but cell is closer
		else if (power != null && cell != null && distance(position, cell.position) < distance(position, power.position)) 
		{
			if (this.energyCell.energyLevel <= triggerValue && cell.energyLevel >= this.energyCell.energyLevel && cell.energyLevel >= triggerValue && NuclearCellCheck(cell) == true)
			{
				if (cell.category == PowerCell)
				{
					message("CollectTitanium4() - " + this.category + " " + this.id + " " + " - Can't reach power facility or a PowerCell is closer.");
				}
				else if (cell.category == NuclearCell)
				{
					message("CollectTitanium4() - " + this.category + " " + this.id + " " + " - Can't reach power facility or a NuclearCell is closer.");
				}
				trygoto(cell.position);
				if (load != null)
				{
					turn(90);
					drop();
					turn(-90);
				}
				grab();
				drop(Behind);
				grab(EnergyCell);
				drop();
				grab(Behind);
				drop(EnergyCell);
			}
		}
	}
	
	//going to recharge facility
	if(power != null && energyCell.energyLevel < triggerValue && energyCell.category != NuclearCell)
	{
		message("CollectTitanium4() - " + this.category + " " + this.id + " " + " - Battery low, going to the recharge facility");
		if(search(Any,power.position,0,2,1,FilterOnlyLanding | FilterFriendly) != null) //if there is a object (most likely another bot) on the recharge facility
		{
			message("CollectTitanium4() - " + this.category + " " + this.id + " " + " - Something is close to the recharge facility, going to the nearby location to avoid potential collisions.");
			trygoto(space(power.position));
		}
		trygoto(power.position);
		while(energyCell.energyLevel < 1)
		{
			wait(1);
		}
	}
	else if (energyCell.energyLevel < triggerValue && power == null && energyCell.category == PowerCell) //checking if we have power cell so that we wont display this error needlessly
	{
		message("CollectTitanium4() - " + this.category + " " + this.id + " " + " - Power Station/Captor not found.", DisplayError);
	}
	else if (energyCell.energyLevel < triggerValue && canbuild(PowerStation) == false && canbuild(PowerCaptor) == false && energyCell.category == PowerCell) //can't do canbuild(list), it expects a int value (not list) or category name
	{
		message("CollectTitanium4() - " + this.category + " " + this.id + " " + " - Power Station/Captor not accessible in this mission.", DisplayWarning);
	}
	
	//integrity check
	int repairList[];
	
	repairList[0] = RepairCenter;
	repairList[1] = Shielder;
	
	repair = radar(repairList);
	
	if(repair != null && shieldLevel < 0.5)
	{
		message("CollectRawResources() - " + this.category + " " + this.id + " " + " - Structural integrity low, going to Repair Center", DisplayInfo);
		trygoto(repair.position);
		while(shieldLevel < 1)
		{
			wait(1);
		}
	}
	else if (shieldLevel < 0.5 && repair == null)
	{
		message("CollectRawResources() - " + this.category + " " + this.id + " " + " - Power Station/Captor not found.", DisplayError);
	}
	else if (shieldLevel < 0.5 && canbuild(RepairCenter) == false && repair == null)
	{
		message("CollectRawResources() - " + this.category + " " + this.id + " " + " - Power Station/Captor not accessible in this mission.", DisplayWarning);
	}
	
	errmode(1);
}
bool object::NuclearCellCheck(object cell) // ensures the bot won't pick a PowerCell when having a NuclearCell inside just because the power meter is higher on the former
{
	
	if (this.energyCell.category == PowerCell)
	{
		return true;
	}
	
	float cellPower = cell.energyLevel;
	float botBatteryPower = this.energyCell.energyLevel;
	int botBatteryCategory = this.energyCell.category;
	
	//message("Power level of the bot: " + botBatteryPower + " and power level of the found cell: " + cellPower);
	if (cellPower > botBatteryPower && (botBatteryCategory == NuclearCell && botBatteryPower < 0.01))
	{
		return false;
	}
	return false;
}
void object::trygoto(point pos)
{
	errmode(0);
	int tries = 0;
	while (distance(position, pos) > 0) //While we are moving towards destination...
	{
		temperatureGuard(); //...we're checking if the flying bot's engine is overheating
		while (goto(pos) != 0) //How we are handling goto() errors
		{
			if(tries > 2)
			{
				point midPoint;
				midPoint.x = ((position.x + pos.x) / 2);
				midPoint.y = ((position.y + pos.y) / 2);
				midPoint.z = ((position.z + pos.z) / 2);
				goto(midPoint);
				wait(1);
				goto(pos, 0, 1);
				break;
			}
			else wait(2);
			tries++;
		}
		errmode(1);
		break;
	}
}
void object::temperatureGuard()        //land if temperature is to high
{
	point loc;
	int counter;
	
	if(temperature > 0.7) 
	{
		message("Debug - temperatureGuard() active");
		jet(0);
		
		while(topo(position) < 0)         //find somewhere to land
		{                                                         
			counter = 0;
			while(counter < 36)        //part made by sclover@abac.com
			{
				loc.x = (cos(orientation) * 20.0) + position.x;
				loc.y = (sin(orientation) * 20.0) + position.y;
				loc.z = position.z + 5.0;
				
				if(topo(loc) >= -0.7)
				{
					move(20);
					break;
				}
				turn(10);
				counter++;
			}
			
			if(topo(position) >= 0)
			{
				break;
			}
			motor(1, 1);
			wait(2);
		}
		
		motor(0, 0);        //stop and land
		jet( -1 );
		
	}
}