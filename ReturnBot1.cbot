extern void object::ReturnBot1() //a simple program that prepares the cubes for mission 1-2
{
	object cube, post, cubeInFront, cell, ship;
	
	if (load == null)
	{
		cube = radar(Titanium);
		goto(cube.position);
		grab();
		goto(flatspace(position,5));
		drop();
		cubeInFront = radar(Titanium,0,90,0,4);
	}
	else if (load != null && load.category == Titanium && radar(BotFactory) == null)
	{
		goto(flatspace(position,5));
		drop();
		cubeInFront = radar(Titanium,0,90,0,4);
	}
	
	if (sizeof(radarall(BotFactory)) == 1)
	{
		
		ship = radar(SpaceShip);
		message("Construction materials placed (" + cubeInFront.position + ") now sending coordinates for it to ExchangePost");
		goto(ship.position);
		send("cubeInFrontX",cubeInFront.position.x);
		send("cubeInFrontY",cubeInFront.position.y);
		send("cubeInFrontZ",cubeInFront.position.z);
		message("Waiting until BotFactory is constructed, activate the other script on builder bot.");
		while (sizeof(radarall(BotFactory)) == 1)
		{
			wait(1);
		}
		//message("Operational BotFactory detected, creating the second WheeledGrabber.");
	}
	message("Operational BotFactory detected, creating the second WheeledGrabber.");
	if (load != null && load.category == Titanium)
	{
		object botFactory = radar(BotFactory,0,360,1,1000,-1);
		
		if (search(Titanium,botFactory.position,0,3) != null) //there is already a titanium cube in BotFactory)
		{
			goto(space());
			drop();
		}
		goto(botFactory.position);
		if (load != null)
		{
			drop();
		}
		
		move(-2);
		factory(WheeledGrabber);
		
		object[] cellList = radarall(PowerCell);
		
		for (int i = 0; i == sizeof(cellList); i++)
		{
			if (cellList[i].energyLevel == 1)
			{
				cell = cellList[i];
			}
		}
		goto(cell.position);
		grab();
		
		float angle = botFactory.orientation;
		float radius = 5;
		point factoryFront (botFactory.position.x + radius * cos(angle), botFactory.position.y + radius * sin(angle));
		
		goto(factoryFront);
		while(isbusy(botFactory) == true)
		{
			wait(1);
		}
		drop();
		goto(ship.position);
		message("Grabber finished the assignment!");
	}
	else
	{
		cube = radar(Titanium);
		goto(cube.position);
		grab();
		
		object botFactory = radar(BotFactory,0,360,1,1000,-1);
		
		if (search(Titanium,botFactory.position,0,3) != null) //there is already a titanium cube in BotFactory)
		{
			goto(space());
			drop();
		}
		goto(botFactory.position);
		if (load != null)
		{
			drop();
		}
		goto(botFactory.position);
		drop();
		move(-2);
		factory(WheeledGrabber);
		
		object[] cellList = radarall(PowerCell);
		
		for (int i = 0; i == sizeof(cellList); i++)
		{
			if (cellList[i].energyLevel == 1)
			{
				cell = cellList[i];
			}
		}
		goto(cell.position);
		grab();
		
		float angle = botFactory.orientation;
		float radius = 5;
		point factoryFront (botFactory.position.x + radius * cos(angle), botFactory.position.y + radius * sin(angle));
		
		goto(factoryFront);
		while(isbusy(botFactory) == true)
		{
			wait(1);
		}
		drop();
		goto(ship.position);
		message("Grabber finished the assignment!");
	}
	
}
