extern void object::SafeCrackerNoCheat()
{
	object vault = radar(Vault);
	
	if(vault == null)
	{
		message("Vault not found. Manual check required, halting program.", DisplayWarning);
		return;
	}
	if(ClawCheck() == true) //if there's a key in grabber's claw
	{
		trygoto(space(vault.position));
		drop();
		TransportKeys(vault,load.category);
	}
	else
	{
		TransportKeys(vault,-1);
	}
}
point object::GetKeyhole(point var, object vault) // returns a point in front of the a vault's keyhole, grabber goes there instead of the building itself, huge thanks to tomaszkax86 for providing a solution 
{
	float angle = vault.orientation;
	float radius = 7; //watch this space
	point keyhole;
	keyhole.x = var.x + radius * cos(angle);
	keyhole.y = var.y + radius * sin(angle);
	
	return keyhole;
}
void object::trygoto(point pos)
{
	errmode(0);
	int tries = 0;
	ipf(1000);
	while (distance(position, pos) > 0) //While we are moving towards destination...
	{
		while (goto(pos) != 0) //How we are handling goto() errors
		{
			if(tries > 2)
			{
				point midPoint;
				midPoint.x = ((position.x + pos.x) / 2);
				midPoint.y = ((position.y + pos.y) / 2);
				midPoint.z = ((position.z + pos.z) / 2);
				goto(midPoint);
				wait(1);
				goto(pos, 0, 1);
				break;
			}
			else wait(2);
			tries++;
		}
		errmode(1);
		break;
	}
}
bool object::ClawCheck()
{
	if(load != null && (load.category == KeyA or load.category == KeyB or load.category == KeyC or load.category == KeyD))
	{
		return true;
	}
	else
	{
		return false;
	}
	return false;
}
void object::TransportKeys(object vault,int keyCategory) //finds the key and moves with it to the vault's vicinity
{
	for (int j = 0;j <= 3;j++)
	{
		errmode(0);
		point keyPos = PickKey(vault);
		if (keyCategory != -1)
		{
			trygoto(space(vault.position));
			PlaceKeys(vault);
		}
		if (keyPos != new point(9999,9999,999))
		{
			trygoto(keyPos);
			grab();
			trygoto(space(vault.position));
			PlaceKeys(vault);
		}
		else
		{
			message("All keys are at the vault's position, halting script.");
			break;
		}
		errmode(1);
	}
}
point object::PickKey(object vault)
{
	object[] keyList;
	keyList[0] = radar(KeyA);
	keyList[1] = radar(KeyB);
	keyList[2] = radar(KeyC);
	keyList[3] = radar(KeyD);
	object key;
	
	for (int j = 0;j <= 3;j++)
	{
		key = keyList[j];
		if (key != null and distance(key.position,vault.position) > 10)
		{
			key = keyList[j];
			return key.position;
		}
	}
	return new point(9999,9999,999);
}
void object::PlaceKeys(object vault)
{
	point pntKeyA;
	point keyholeA;
	point pntKeyB;
	point keyholeB;
	point pntKeyC;
	point keyholeC;
	point pntKeyD;
	point keyholeD;
	
	float fltAng;
	float fltOri = vault.orientation;
	    
	fltAng = fltOri-180;
	pntKeyA.x = vault.position.x + (4*cos(fltAng));
	pntKeyA.y = vault.position.y + (4*sin(fltAng));
	keyholeA = GetKeyhole(pntKeyA, vault);
	
	if(search(KeyA,pntKeyA,0,3) == null)
	{
		message("Trying to reach the A point");
		produce(pntKeyA,0,BlueFlag);
		trygoto(pntKeyA);
		wait(0.5);
		turn(direction(vault.position));
		move(-2);
		drop();
	}
	
	fltAng = fltOri;
	pntKeyB.x = vault.position.x + (4*cos(fltAng));
	pntKeyB.y = vault.position.y + (4*sin(fltAng));
	keyholeB = GetKeyhole(pntKeyB, vault);
	
	if (search(KeyB,pntKeyB,0,3) == null)
	{
		message("Trying to reach the B point");
		trygoto(pntKeyB);
		wait(0.5);
		turn(direction(vault.position));
		move(-2);
		drop();
	}
	
	fltAng = fltOri-90;
	pntKeyC.x = vault.position.x + (4*cos(fltAng));
	pntKeyC.y = vault.position.y + (4*sin(fltAng));
	keyholeC = GetKeyhole(pntKeyC, vault);
	
	if(search(KeyC,pntKeyC,0,3) == null)
	{
		message("Trying to reach the C point");
		trygoto(pntKeyC);
		wait(0.5);
		turn(direction(vault.position));
		move(-2);
		drop();
	}
	
	fltAng = fltOri+90;
	pntKeyD.x = vault.position.x + (4*cos(fltAng));
	pntKeyD.y = vault.position.y + (4*sin(fltAng));
	keyholeD = GetKeyhole(pntKeyD, vault);
	
	if(search(KeyD,pntKeyD,0,3) == null)
	{
		message("Trying to reach the D point");
		trygoto(pntKeyD);
		wait(0.5);
		turn(direction(vault.position));
		move(-2);
		drop();
	}
}
